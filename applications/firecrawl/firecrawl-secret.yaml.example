# Firecrawl 可选能力凭据模板
#
# 用法：复制为 firecrawl-secret.yaml 并填入实际值。
# 真实文件由 .gitignore 排除（*secret.yaml），不会入库。
#
# 纯 markdown 抓取可全部留空；按需填写对应能力所需的键。
apiVersion: v1
kind: Secret
metadata:
  name: firecrawl-secret
type: Opaque
stringData:
  # LLM 抽取（/extract、json 格式化）。留空则抽取路径不可用
  OPENAI_API_KEY: ""

  # 上游代理，配 PROXY_SERVER / PROXY_USERNAME 使用
  PROXY_PASSWORD: ""

  # Redis 密码，与 REDIS_URL 中的认证部分对应；自建无密码可留空
  REDIS_PASSWORD: ""

  # Bull 队列管理面板的访问口令
  BULL_AUTH_KEY: ""

  # 自托管 webhook 的 HMAC 签名密钥，配 SELF_HOSTED_WEBHOOK_URL 使用
  SELF_HOSTED_WEBHOOK_HMAC_SECRET: ""

  # LlamaParse 文档解析
  LLAMAPARSE_API_KEY: ""

  # 任务通知
  SLACK_WEBHOOK_URL: ""

  # Fire Engine（官方托管增强抓取），自托管通常留空
  FIRE_ENGINE_BETA_URL: ""
