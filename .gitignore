.kiro
.dev
*.info
*secret.yaml
__pycache__
tmp

# Kustomize overlay：默认忽略全部环境目录，仅放行 example
# 环境 overlay 含集群名、桶名等真实取值，不入库
# 用法：cp -r overlays/example overlays/<你的集群名>，填入真实值
tools/*/overlays/*
!tools/*/overlays/example/
applications/*/overlays/*
!applications/*/overlays/example/

# NodePool/NodeClass 含集群专属的 role 名与 discovery 标签
gpu/overlays/*
!gpu/overlays/example/
karpenter/overlays/*
!karpenter/overlays/example/
